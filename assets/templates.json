  "welcome": {
    "name": "\u2728 Welcome & Counter Demo",
    "description": "Interactive card with counter, custom styling and JavaScript",
    "code": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Reading Steiner</title>\n  <style>\n    * { box-sizing: border-box; margin: 0; padding: 0; }\n    body {\n      font-family: system-ui, -apple-system, sans-serif;\n      background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 100%);\n      color: #f8fafc;\n      min-height: 100vh;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      padding: 20px;\n    }\n    .card {\n      background: rgba(255, 255, 255, 0.07);\n      backdrop-filter: blur(16px);\n      border: 1px solid rgba(255, 255, 255, 0.15);\n      border-radius: 20px;\n      padding: 32px;\n      max-width: 440px;\n      width: 100%;\n      box-shadow: 0 20px 40px rgba(0,0,0,0.4);\n      text-align: center;\n    }\n    h1 {\n      font-size: 26px;\n      margin-bottom: 8px;\n      background: linear-gradient(90deg, #38bdf8, #818cf8, #c084fc);\n      -webkit-background-clip: text;\n      -webkit-text-fill-color: transparent;\n    }\n    p {\n      color: #94a3b8;\n      font-size: 14px;\n      margin-bottom: 24px;\n    }\n    .counter-display {\n      font-size: 54px;\n      font-weight: 800;\n      color: #38bdf8;\n      margin: 16px 0;\n      font-family: monospace;\n    }\n    .btn-group {\n      display: flex;\n      gap: 12px;\n      justify-content: center;\n    }\n    button {\n      background: #4f46e5;\n      color: white;\n      border: none;\n      padding: 12px 22px;\n      font-size: 15px;\n      font-weight: 600;\n      border-radius: 10px;\n      cursor: pointer;\n      transition: transform 0.15s, background 0.2s;\n    }\n    button:hover {\n      background: #6366f1;\n      transform: translateY(-2px);\n    }\n    button:active {\n      transform: translateY(0);\n    }\n    button.reset {\n      background: rgba(255, 255, 255, 0.12);\n    }\n    button.reset:hover {\n      background: rgba(255, 255, 255, 0.2);\n    }\n  </style>\n</head>\n<body>\n  <div class=\"card\">\n    <h1>Reading Steiner Ready! \ud83d\ude80</h1>\n    <p>Edit this code in the editor, then click <b>Play</b> (or press <kbd>Ctrl+Enter</kbd>) to run it.</p>\n    <div class=\"counter-display\" id=\"count\">0</div>\n    <div class=\"btn-group\">\n      <button onclick=\"increment()\">+ Increment</button>\n      <button class=\"reset\" onclick=\"reset()\">Reset</button>\n    </div>\n  </div>\n\n  <script>\n    let count = 0;\n    function increment() {\n      count++;\n      document.getElementById('count').textContent = count;\n      console.log('Count incremented to:', count);\n    }\n    function reset() {\n      count = 0;\n      document.getElementById('count').textContent = count;\n      console.log('Count reset');\n    }\n    console.log('Welcome to Reading Steiner! Execution started successfully.');\n  </script>\n</body>\n</html>"
  },
